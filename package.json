{
  "name": "dsh-plugin-preflight",
  "version": "0.15.3",
  "type": "module",
  "icon": "./icon.svg",
  "description": "插件安装预检闸门：在 pluginManager.installBundle 之前跑预检，判定为拒绝时中止安装，并把每次检查写入审计日志；侧栏面板可切换拦截/只记录、调整规则与阈值。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "guard",
    "security",
    "preflight",
    "supply-chain"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./policy.json": "./policy.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "policy.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/preflight.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  }
}
